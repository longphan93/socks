# Sao chép thành .env rồi điền giá trị thật.
NODE_ENV=development
PORT=4000
# Domain được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:4001

# --- D1 gateway (bắt buộc) ---
# Dev local: chạy `npm run gateway:dev`, mặc định nghe ở cổng 8787
D1_GATEWAY_URL=http://127.0.0.1:8787
# Phải trùng GATEWAY_SECRET của Worker, tối thiểu 16 ký tự
D1_GATEWAY_SECRET=dev-secret-doi-truoc-khi-deploy
D1_GATEWAY_TIMEOUT_MS=10000
D1_GATEWAY_RETRIES=2
CATALOG_CACHE_TTL_MS=30000

# --- Đăng nhập admin (bắt buộc từ Phase 3) ---
# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-toi-thieu-32-ky-tu-truoc-khi-deploy
JWT_EXPIRES_IN=7d
# Giới hạn chung mỗi IP mỗi phút; để rộng vì nhà mạng hay NAT nhiều thuê bao
THROTTLE_LIMIT=600
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=300000

# --- Cloudflare (migration lúc khởi động, backup DB) ---
CLOUDFLARE_ACCOUNT_ID=
# Token cần quyền D1 Edit để container tự chạy migration
CLOUDFLARE_API_TOKEN=

# --- Lưu ảnh sản phẩm (bắt buộc từ Phase 5) ---
# Dev: chạy `npm run dev:infra` rồi dùng LocalStack bên dưới.
# Production: đổi endpoint sang R2, phần còn lại giữ nguyên hình dạng.
R2_ENDPOINT=http://127.0.0.1:4566
R2_BUCKET=socks-media
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_PUBLIC_BASE_URL=http://127.0.0.1:4566/socks-media
# R2 thật:
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://media.example.com

# --- Email (bắt buộc từ Phase 8). Dev dùng Mailpit: npm run mail:dev ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Socks Shop <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=admin@example.com
# Landing page nhận feedback nằm trên chính site (Phase 10)
FEEDBACK_URL=http://localhost:4001/feedback

# --- Tài khoản admin seed (bắt buộc từ Phase 3) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay
