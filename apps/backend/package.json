{
  "name": "@socks/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"d1-gateway/src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npm run db:migrate && node dist/main",
    "lint": "oxlint --type-aware src/ test/ d1-gateway/src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "gateway:dev": "wrangler dev --config d1-gateway/wrangler.toml",
    "gateway:deploy": "wrangler deploy --config d1-gateway/wrangler.toml",
    "gateway:typecheck": "tsc --noEmit -p d1-gateway/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run gateway:typecheck",
    "mail:dev": "docker compose -f docker-compose.dev.yml up -d mailpit",
    "mail:stop": "docker compose -f docker-compose.dev.yml down",
    "r2:test": "node --env-file=.env scripts/test-r2-presign.mjs",
    "db:migrate": "node dist/migrate",
    "db:migrate:revert": "node dist/migrate revert",
    "db:seed": "node dist/seed",
    "db:seed:demo": "SEED_DEMO=true node dist/seed",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:stop": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@longphan93/nestjs-migration": "file:../../vendor/longphan93-nestjs-migration-1.0.1.tgz",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.152.0"
  }
}
