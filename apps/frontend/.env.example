# Sao chép thành .env rồi điền giá trị thật.
# Backend chạy ở cổng 4000, frontend ở 4001.
# NEXT_PUBLIC_SITE_URL phải khớp CORS_ORIGINS trong backend/.env.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:4001

# Domain phục vụ ảnh sản phẩm khi chạy thật (bỏ trống khi dev dùng LocalStack)
NEXT_PUBLIC_MEDIA_HOST=
